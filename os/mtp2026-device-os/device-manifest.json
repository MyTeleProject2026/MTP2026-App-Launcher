{
  "id": "mtp2026-device-os",
  "name": "MTP2026 Device OS",
  "version": "0.2.0-real-runtime-foundation",
  "architecture": ["arm64"],
  "identity": {
    "provider": "VexaAccount",
    "accountRole": "device-and-user-identity",
    "store": "VexaStore",
    "storeUrl": "https://www.vexastore.2bd.net/",
    "accountManagementUrl": "https://vexaaccount-management.onrender.com"
  },
  "branding": {
    "icon": "/icon.svg",
    "brandGuide": "/branding/README.md",
    "provenance": "/branding/brand-provenance.json"
  },
  "storage": {
    "model": "logical-partitions",
    "hostBackends": ["OPFS", "IndexedDB", "native-filesystem-bridge"],
    "partitions": [
      {"id":"system","purpose":"OS shell, configuration and signed system resources"},
      {"id":"user","purpose":"documents, media and imported user files"},
      {"id":"applications","purpose":"installed MTP2026 apps, manifests and package metadata"},
      {"id":"cache","purpose":"temporary runtime and web cache data"}
    ]
  },
  "packageManager": {
    "id": "vexastore-package-manager",
    "store": "VexaStore",
    "artifact": "apk",
    "verification": ["HTTPS", "publisher-signature", "package-name", "platform-package-installer"],
    "nativeAndroid": "PackageInstaller",
    "browser": "web-app-only",
    "automaticInstall": "requires-native-installer-privilege-or-platform-user-approval"
  },
  "runtime": {
    "controlPlane": "MTP2026 App Launcher",
    "guestExecution": "native-arm64-or-compatible-emulator",
    "browserShell": true,
    "bareMetalKernel": "../arm64-kernel"
  },
  "security": {
    "identity": "VexaAccount",
    "applicationIsolation": "per-app-storage-and-origin",
    "packageTrust": "VexaStore-signature-policy",
    "proprietaryOsImages": "never-bundled-without-authorized-distribution"
  },
  "systemApps": [
    "VexaStore",
    "VexaAccount",
    "Settings",
    "Files",
    "VexaBrowser",
    "VexaEmail",
    "VexaTube",
    "VexaCloud",
    "Vexa Passwords"
  ]
}
