#!/bin/sh
set -eu
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true

clear || true
cat /etc/motd
printf '\nProfile: %s\n' "@PROFILE_NAME@"
printf 'Architecture: arm64\n'
printf 'Identity: VexaAccount\n'
printf 'Application store: VexaStore\n'
printf 'Application root: /var/lib/mtp2026/apps\n'
printf 'System services: account store webapp notifications settings files device-os\n'
printf '\n'

export HOME=/home
export PATH=/usr/bin:/bin:/sbin
export MTP2026_PROFILE="@PROFILE@"
export MTP2026_PROFILE_NAME="@PROFILE_NAME@"

# MTP2026 guest service bootstrap. These services expose the same stable
# launcher-managed contracts to every ARM64 profile while the profile-specific
# UI/runtime remains different on the browser/native side.
mkdir -p /run/mtp2026 /var/lib/mtp2026/apps /mnt/device-storage
MTP2026_DATA_DEVICE="/dev/vdb"
for arg in $(cat /proc/cmdline 2>/dev/null || true); do
  case "$arg" in mtp2026.data_device=*) MTP2026_DATA_DEVICE="${arg#mtp2026.data_device=}";; esac
done
echo "$MTP2026_DATA_DEVICE" > /run/mtp2026/data-device
# Read the non-secret VexaAccount identity metadata supplied by the native host
# through QEMU fw_cfg. Provider access/refresh tokens are never placed here.
IDENTITY_FWCFG="/sys/firmware/qemu_fw_cfg/by_name/opt/mtp2026/identity/raw"
if [ -r "$IDENTITY_FWCFG" ]; then
  cat "$IDENTITY_FWCFG" > /run/mtp2026/identity.json
fi
# Persistent guest storage is supplied by the native QEMU host as virtio-blk.
# Keep the initramfs usable when no persistent disk is attached (browser/CI boot).
if [ -b "$MTP2026_DATA_DEVICE" ]; then
  if ! mountpoint -q /mnt/device-storage 2>/dev/null; then
    mount -t ext4 "$MTP2026_DATA_DEVICE" /mnt/device-storage 2>/dev/null || true
    if ! mountpoint -q /mnt/device-storage 2>/dev/null && command -v mkfs.ext2 >/dev/null 2>&1; then
      echo "Formatting new persistent guest storage..."
      mkfs.ext2 -F "$MTP2026_DATA_DEVICE" >/dev/null 2>&1 || true
      mount -t ext4 "$MTP2026_DATA_DEVICE" /mnt/device-storage 2>/dev/null || mount -t ext2 "$MTP2026_DATA_DEVICE" /mnt/device-storage 2>/dev/null || true
    fi
  fi
  if mountpoint -q /mnt/device-storage 2>/dev/null; then
    mkdir -p /mnt/device-storage/{Desktop,Documents,Downloads,Pictures,Music,Games,Apps}
    printf '%s\n' 'persistent-storage-ready' > /run/mtp2026/storage
  fi
fi
for service in account store webapp notifications settings files device-os; do
  /usr/bin/mtp2026-daemon "$service" >/run/mtp2026/"$service".log 2>&1 &
  printf '%s\n' "$!" > "/run/mtp2026/$service.pid"
  printf 'active\n' > "/run/mtp2026/$service"
done

# Start the native guest compositor in the background. It owns the graphical
# framebuffer/input surface; the init shell remains available on serial for
# diagnostics and recovery.
if [ -x /usr/bin/mtp2026-ui ]; then
  /usr/bin/mtp2026-ui >/run/mtp2026/gui.log 2>&1 &
  echo $! > /run/mtp2026/gui.pid
  echo "MTP2026 GUI COMPOSITOR STARTED"
fi

status() {
  service="$1"
  if [ -f "/run/mtp2026/$service" ]; then
    echo "mtp2026-$service: active (profile=@PROFILE@)"
  else
    echo "mtp2026-$service: inactive"
  fi
}

profile_features() {
  case "@PROFILE@" in
    mtp2026) echo "Device OS: mobile gestures, Control Center, notifications, VexaStore, WebApps" ;;
    android) echo "Android OS: mobile launcher, gesture/three-button navigation, Quick Settings, APK host handoff" ;;
    desktop) echo "Desktop OS: desktop workspace, Start/taskbar, files, keyboard/mouse, native package handoff" ;;
    gaming) echo "Gaming OS: Game Hub, controller navigation, performance mode, game library, native game handoff" ;;
    *) echo "Profile: @PROFILE@" ;;
  esac
}

while true; do
  printf '\nMTP2026[%s]> ' "@PROFILE@"
  if ! IFS= read -r command; then exit 0; fi
  case "$command" in
    ""|help)
      echo "Commands: help, about, profile, services, memory, storage, apps, account, store, browser, browser-test, settings, files, notifications, network, install <manifest-url>, reboot, poweroff"
      ;;
    about)
      cat /etc/os-release
      uname -a
      ;;
    profile)
      profile_features
      /usr/bin/mtp2026-system-info
      ;;
    services)
      for service in account store webapp notifications settings files device-os; do status "$service"; done
      ;;
    memory)
      cat /proc/meminfo | head -n 8
      ;;
    storage)
      df -h
      ;;
    apps)
      echo "Installed MTP2026 applications:"
      if [ -d /var/lib/mtp2026/apps ]; then
        find /var/lib/mtp2026/apps -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null || true
      fi
      ;;
    account)
      status account
      echo "VexaAccount is the identity authority for this MTP2026 guest."
      echo "The browser/native launcher owns interactive authentication and session tokens."
      ;;
    store)
      status store
      echo "VexaStore application catalog: https://www.vexastore.2bd.net/"
      echo "Install protocol: VexaStore manifest -> verified package -> /var/lib/mtp2026/apps"
      ;;
    browser-test)
      if [ -x /usr/bin/chromium ]; then
        echo "MTP2026 Browser ARM64 binary smoke test starting..."
        if /usr/bin/chromium --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --dump-dom 'data:text/html,<title>MTP2026 Browser</title><h1>MTP2026 Browser OK</h1>' 2>/run/mtp2026/browser-test.err | grep -q 'MTP2026 Browser OK'; then
          echo "MTP2026 BROWSER SMOKE TEST PASSED"
        else
          echo "MTP2026 BROWSER SMOKE TEST FAILED"
          cat /run/mtp2026/browser-test.err 2>/dev/null || true
        fi
      else
        echo "MTP2026 BROWSER SMOKE TEST FAILED: chromium binary missing"
      fi
      ;;
    browser)
      status webapp
      echo "MTP2026 Browser is a guest-native ARM64 Chromium-compatible application."
      echo "Browser contract: /etc/mtp2026/browser.json"
      if [ ! -x /usr/bin/chromium ]; then echo "MTP2026_BROWSER_ENGINE_NOT_INSTALLED"; exit 127; fi
      echo "Persistent profile: /mnt/device-storage/Apps/.mtp2026-browser-profile"
      echo "Opening VexaAccount inside the guest browser..."
      /usr/bin/mtp2026-browser "${MTP2026_BROWSER_URL:-https://vexaaccount-management.onrender.com}" || {
        echo "Browser engine is not installed in this guest image."
        echo "Use an ARM64 Chromium/WebView-compatible build in the guest image."
      }
      echo "Native guest packages are handed to a compatible host installer; the browser does not execute APK/EXE binaries."
      ;;
    settings)
      status settings
      echo "Settings service: display, orientation, sound, notifications, account, storage, power."
      ;;
    files)
      status files
      echo "File service: Desktop, Documents, Downloads, Pictures, Music, Games and Device Storage."
      if [ -f /run/mtp2026/storage ]; then echo "Persistent storage: active ($MTP2026_DATA_DEVICE -> /mnt/device-storage)"; else echo "Persistent storage: not attached"; fi
      ;;
    notifications)
      status notifications
      echo "Notification service: launcher-managed guest notifications."
      ;;
    network)
      echo "Network interfaces:"
      cat /proc/net/dev
      ;;
    install\ *)
      URL="${command#install }"
      /usr/bin/mtp2026-app-install "$URL"
      ;;
    reboot)
      reboot -f
      ;;
    poweroff)
      poweroff -f
      ;;
    *)
      case "$command" in
        service\ status\ *) status "${command#service status }" ;;
        service\ start\ *) service="${command#service start }"; printf 'active\n' > "/run/mtp2026/$service" 2>/dev/null || true; status "$service" ;;
        service\ stop\ *) service="${command#service stop }"; rm -f "/run/mtp2026/$service"; status "$service" ;;
        *) echo "Unknown command: $command" ;;
      esac
      ;;
  esac
done
