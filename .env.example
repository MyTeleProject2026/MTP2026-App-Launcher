# MTP2026 App Launcher
# Never commit real secrets.
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://mtp2026-app-launcher.onrender.com

# VexaAccount registered application SSO contract
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"vexa_mtp2026-app-launcher_b1f581a66224d89c","redirectUri":"https://mtp2026-app-launcher.onrender.com/auth/callback","scopes":["openid","profile","email","account","session","applications","notifications"],"timeoutMs":10000}
VEXA_ACCOUNT_CLIENT_SECRET=SET_IN_RENDER_BACKEND_ONLY
MTP_SESSION_ENCRYPTION_KEY=SET_A_LONG_RANDOM_SECRET_IN_RENDER_BACKEND_ONLY

# TiDB Cloud MySQL-compatible endpoint
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
TIDB_SSL=true
TIDB_SSL_REJECT_UNAUTHORIZED=true

# Browser origin allowed to call the API
FRONTEND_ORIGIN=https://mtp2026-app-launcher.onrender.com

# Frontend build-time API URL
VITE_API_BASE_URL=https://mtp2026-app-launcher-backend.onrender.com/api
