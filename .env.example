# MTP2026 App Launcher
# Configure these values for the deployment environment.

NODE_ENV=development
PORT=4000

# Public launcher URL
APP_BASE_URL=http://localhost:5173

# VexaAccount OIDC integration
VEXA_ACCOUNT_ISSUER_URL=
VEXA_ACCOUNT_CLIENT_ID=
VEXA_ACCOUNT_CLIENT_SECRET=
VEXA_ACCOUNT_REDIRECT_URI=http://localhost:5173/auth/callback

# TiDB Cloud (MySQL-compatible)
# Example: mysql://USER:PASSWORD@HOST:4000/DATABASE
DATABASE_URL=
TIDB_SSL=true
TIDB_SSL_REJECT_UNAUTHORIZED=false

# Frontend API URL
VITE_API_BASE_URL=http://localhost:4000/api
