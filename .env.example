# MTP2026 App Launcher
# Production values below match the current Render deployments.
# Never commit real secrets.

NODE_ENV=production
PORT=4000

APP_BASE_URL=https://mtp2026-app-launcher.onrender.com

# VexaAccount OIDC integration
VEXA_ACCOUNT_ISSUER_URL=https://api-vexaaccount.onrender.com
VEXA_ACCOUNT_CLIENT_ID=mtp2026-app-launcher
VEXA_ACCOUNT_CLIENT_SECRET=SET_IN_RENDER_BACKEND_ONLY
VEXA_ACCOUNT_REDIRECT_URI=https://mtp2026-app-launcher.onrender.com/auth/callback

# TiDB Cloud MySQL-compatible endpoint
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
TIDB_SSL=true
TIDB_SSL_REJECT_UNAUTHORIZED=true

# Frontend API URL
VITE_API_BASE_URL=https://mtp2026-app-launcher-backend.onrender.com/api
