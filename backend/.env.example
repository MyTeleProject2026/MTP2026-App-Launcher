PORT=4000
NODE_ENV=production

# TiDB Cloud / TiDB MySQL
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE
TIDB_SSL=true
TIDB_SSL_REJECT_UNAUTHORIZED=true

# VexaAccount external application SSO contract
# Keep the secret only in the backend Render Web Service.
VEXA_ACCOUNT_CLIENT_SECRET=SET_THE_REGISTERED_MTP2026_SECRET_IN_RENDER

# API issuer is used for token exchange/userinfo. userUrl is the canonical VexaAccount User frontend
# browser entry point and MUST be the deployed User frontend origin, without a trailing slash.
# Never put clientSecret in this JSON.
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","userUrl":"https://YOUR-VEXAACCOUNT-USER-FRONTEND","clientId":"mtp2026-app-launcher","redirectUri":"https://mtp2026-app-launcher.onrender.com/auth/callback","scopes":["openid","profile","email"],"timeoutMs":10000}

# Optional independent key used to encrypt persisted backend session tokens.
MTP_SESSION_ENCRYPTION_KEY=SET_A_LONG_RANDOM_SECRET_IN_RENDER

# Browser origin allowed to call the API
FRONTEND_ORIGIN=https://mtp2026-app-launcher.onrender.com
