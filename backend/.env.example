PORT=4000
NODE_ENV=production

# TiDB Cloud / TiDB MySQL
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE
TIDB_SSL=true
TIDB_SSL_REJECT_UNAUTHORIZED=true

# VexaAccount external application SSO contract.
# The client ID and redirect URI must match the VexaAccount SSO registry.
# Keep the client secret only in the MTP2026 backend Render Web Service.
VEXA_ACCOUNT_CLIENT_ID=vexa_mtp2026-app-launcher_b1f581a66224d89c
VEXA_ACCOUNT_CLIENT_SECRET=SET_THE_SAME_LONG_RANDOM_SECRET_CONFIGURED_IN_VEXAACCOUNT
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"vexa_mtp2026-app-launcher_b1f581a66224d89c","redirectUri":"https://mtp2026-app-launcher.onrender.com/auth/callback","scopes":["openid","profile","email","account","session","applications","notifications"],"timeoutMs":10000}

# Required independent encryption key for persisted session tokens.
MTP_SESSION_ENCRYPTION_KEY=SET_A_LONG_RANDOM_SECRET_IN_RENDER

# Browser origins allowed to call the API (comma-separated for multiple deployments).
FRONTEND_ORIGIN=https://mtp2026-app-launcher.onrender.com

# Optional real guest-image sources. These must point to actual ARM64 guest
# media that you are authorized to use. MTP2026 never bundles cracked or
# redistributed proprietary OS media. The frontend consumes these through
# /api/guest-runtime-manifest and verifies the configured SHA-256 when set.
MTP2026_GUEST_IMAGE_URL_ANDROID=
MTP2026_GUEST_IMAGE_SHA256_ANDROID=
MTP2026_GUEST_IMAGE_DOCS_ANDROID=https://developer.android.com/topic/generic-system-image

MTP2026_GUEST_IMAGE_URL_IOS=
MTP2026_GUEST_IMAGE_SHA256_IOS=
MTP2026_GUEST_IMAGE_DOCS_IOS=https://developer.apple.com/documentation/virtualization

MTP2026_GUEST_IMAGE_URL_WINDOWS11=
MTP2026_GUEST_IMAGE_SHA256_WINDOWS11=
MTP2026_GUEST_IMAGE_DOCS_WINDOWS11=https://www.microsoft.com/software-download/windows11arm64

MTP2026_GUEST_IMAGE_URL_GAMING=
MTP2026_GUEST_IMAGE_SHA256_GAMING=
MTP2026_GUEST_IMAGE_DOCS_GAMING=
