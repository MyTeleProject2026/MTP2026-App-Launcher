PORT=4000
NODE_ENV=production

# TiDB Cloud / TiDB MySQL
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE
TIDB_SSL=true
TIDB_SSL_REJECT_UNAUTHORIZED=true

# VexaAccount external application SSO contract.
# Keep the secret only in the backend Render Web Service.
VEXA_ACCOUNT_CLIENT_SECRET=SET_THE_REGISTERED_MTP2026_SECRET_IN_RENDER
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"vexa_mtp2026-app-launcher_b1f581a66224d89c","redirectUri":"https://mtp2026-app-launcher.onrender.com/auth/callback","scopes":["openid","profile","email","account","session","applications","notifications"],"timeoutMs":10000}

# Required independent encryption key for persisted session tokens.
MTP_SESSION_ENCRYPTION_KEY=SET_A_LONG_RANDOM_SECRET_IN_RENDER

# Browser origins allowed to call the API (comma-separated for multiple deployments).
FRONTEND_ORIGIN=https://mtp2026-app-launcher.onrender.com
