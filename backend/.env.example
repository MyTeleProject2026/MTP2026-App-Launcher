PORT=4000
NODE_ENV=production

# TiDB Cloud / TiDB MySQL
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE
TIDB_SSL=true
TIDB_SSL_REJECT_UNAUTHORIZED=true
# Optional CA file when your TiDB deployment requires a custom CA.
# TIDB_CA_PATH=/path/to/ca.pem

# VexaAccount SSO / OIDC
VEXA_ACCOUNT_ISSUER_URL=https://api-vexaaccount.onrender.com
VEXA_ACCOUNT_CLIENT_ID=
VEXA_ACCOUNT_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGIN=https://your-mtp2026-launcher.onrender.com
