#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")"&&pwd)";V=8.13;C="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/custom-gradle-$V";D="$C/gradle-$V";if [ ! -x "$D/bin/gradle" ];then mkdir -p "$C";curl -fsSL "https://services.gradle.org/distributions/gradle-$V-bin.zip" -o "$C/gradle.zip";unzip -q "$C/gradle.zip" -d "$C";rm -f "$C/gradle.zip";fi;exec "$D/bin/gradle" -p "$ROOT" "$@"
